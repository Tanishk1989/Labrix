{
  "name": "labrix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:runner:java": "vitest run --config vitest.runner.config.ts",
    "test:runner:cpp": "vitest run --config vitest.cpp-runner.config.ts",
    "test:acceptance:java-workspace": "tsx scripts/run-isolated-verification.ts integration tests/integration/java-runner-workspace.test.ts",
    "test:acceptance:cpp-workspace": "tsx scripts/run-isolated-verification.ts integration tests/integration/cpp-runner-workspace.test.ts",
    "test:db:prepare": "tsx scripts/run-isolated-verification.ts prepare",
    "test:integration": "tsx scripts/run-isolated-verification.ts integration",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "tsx scripts/run-isolated-verification.ts e2e",
    "test:acceptance:read-only": "tsx scripts/run-isolated-verification.ts read-only",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo": "npm.cmd run demo:check && next dev",
    "auth:link-clerk": "tsx scripts/link-clerk-identity.ts",
    "runner:java:pull": "docker pull eclipse-temurin@sha256:55fb9bf738f5d9b4a6c01b39337e3070d3e27370dd3c478fd1d5d3cd2233c6d8",
    "runner:java": "tsx runner/java/server.ts",
    "runner:cpp:pull": "docker pull gcc@sha256:b99b86a28812b1e6453a231a947dc43d76fe192788a12f344a9b568bf9f5d24c",
    "runner:cpp": "tsx runner/cpp/server.ts",
    "acceptance:java-workspace:dev": "tsx scripts/start-java-workspace-acceptance.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
