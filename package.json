{
  "name": "trace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/start-development.ts",
    "assets:prepare": "node scripts/prepare-static-assets.mjs",
    "build": "npm run assets:prepare && prisma generate --schema=backend/prisma/schema.prisma && next build frontend",
    "postinstall": "prisma generate --schema=backend/prisma/schema.prisma && node scripts/prepare-static-assets.mjs",
    "start": "next start frontend",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config tests/vitest.config.ts",
    "test:runner:java": "vitest run --config tests/vitest.runner.config.ts",
    "test:runner:cpp": "vitest run --config tests/vitest.cpp-runner.config.ts",
    "test:acceptance:java-workspace": "tsx scripts/run-isolated-verification.ts integration tests/integration/java-runner-workspace.test.ts",
    "test:acceptance:cpp-workspace": "tsx scripts/run-isolated-verification.ts integration tests/integration/cpp-runner-workspace.test.ts",
    "test:db:prepare": "tsx scripts/run-isolated-verification.ts prepare",
    "test:integration": "tsx scripts/run-isolated-verification.ts integration --exclude tests/integration/java-runner-workspace.test.ts --exclude tests/integration/cpp-runner-workspace.test.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:e2e": "tsx scripts/run-isolated-verification.ts e2e",
    "test:acceptance:read-only": "tsx scripts/run-isolated-verification.ts read-only",
    "db:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "data:remove-demo": "tsx scripts/remove-demo-data.ts --confirm",
    "user:set-role": "tsx scripts/set-user-role.ts",
    "db:local:up": "tsx scripts/local-database.ts up",
    "db:local:down": "tsx scripts/local-database.ts down",
    "db:local:prepare": "tsx scripts/local-database.ts prepare",
    "dev:local": "tsx scripts/local-database.ts dev",
    "demo:check": "tsx scripts/demo-check.ts",
    "demo:reset": "tsx scripts/demo-reset.ts",
    "demo": "tsx scripts/local-database.ts dev",
    "demo:fresh": "npm run db:local:up && npm run demo:reset && npm run demo",
    "demo:real": "tsx scripts/start-real-execution-demo.ts",
    "release:gate": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "verify:production": "tsx scripts/verify-production.ts",
    "verify:runners:remote": "tsx scripts/verify-remote-runners.ts",
    "load:test:web": "tsx scripts/load-test-web.ts",
    "load:test:runners": "tsx scripts/load-test-runners.ts",
    "worker:execution": "tsx backend/worker/execution-worker.ts",
    "auth:link-clerk": "tsx scripts/link-clerk-identity.ts",
    "runner:java:pull": "docker pull eclipse-temurin@sha256:55fb9bf738f5d9b4a6c01b39337e3070d3e27370dd3c478fd1d5d3cd2233c6d8",
    "runner:java": "tsx backend/runner/java/server.ts",
    "runner:cpp:pull": "docker pull gcc@sha256:b99b86a28812b1e6453a231a947dc43d76fe192788a12f344a9b568bf9f5d24c",
    "runner:cpp": "tsx backend/runner/cpp/server.ts",
    "acceptance:java-workspace:dev": "tsx scripts/start-java-workspace-acceptance.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.1",
    "@clerk/themes": "^2.4.57",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^6.19.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.9",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "effect": "^3.22.1",
    "dompurify": "^3.4.14",
    "nanoid": "^3.3.18"
  }
}
