generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             String                     @id @default(cuid())
  name                           String
  email                          String                     @unique
  platformRole                   PlatformRole
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  accountStatus                  AccountStatus              @default(ACTIVE)
  teacherApprovalRequestedAt     DateTime?
  teacherApprovalNotifiedAt      DateTime?
  teacherApprovedAt              DateTime?
  memberships                    ClassMembership[]
  classroomsOwned                Classroom[]                @relation("ClassroomOwner")
  codingSessions                 CodingSession[]            @relation("StudentCodingSessions")
  externalIdentities             ExternalIdentity[]
  authoredMembershipAuditEntries MembershipAuditEntry[]     @relation("MembershipAuditActor")
  studentMembershipAuditEntries  MembershipAuditEntry[]     @relation("MembershipAuditStudent")
  submissionAttempts             SubmissionAttempt[]        @relation("StudentSubmissions")
  submissionReviews              SubmissionReview[]         @relation("TeacherSubmissionReviews")
  submissionReviewRevisions      SubmissionReviewRevision[] @relation("TeacherSubmissionReviewRevisions")
  tasksAuthored                  Task[]                     @relation("TaskAuthor")
  studentHintPermissions         StudentHintPermission[]
  hintPoliciesUpdated            ClassroomHintPolicy[]      @relation("TeacherHintPolicyUpdates")
  hintPermissionsGranted         StudentHintPermission[]    @relation("TeacherHintPermissionsGranted")
  hintInteractions               HintInteraction[]          @relation("StudentHintInteractions")
  adminAuditLogsAdministered     AdminAuditLog[]            @relation("AdminAuditActor")
  aiGenerationAuditLogs          AiGenerationAuditLog[]     @relation("TeacherAiGenerations")
  executionJobs                  ExecutionJob[]              @relation("StudentExecutionJobs")
}

model ExternalIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model Classroom {
  id                     String                 @id @default(cuid())
  name                   String
  subject                String
  section                String
  ownerTeacherId         String
  joinCode               String                 @unique
  joinCodeExpiresAt      DateTime?
  joinCodeRotatedAt      DateTime?
  enrollmentOpen         Boolean                @default(true)
  enrollmentStartsAt     DateTime?
  enrollmentEndsAt       DateTime?
  requireTeacherApproval Boolean                @default(false)
  aiAssistanceEnabled    Boolean                @default(true)
  status                 ClassroomStatus        @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  memberships            ClassMembership[]
  ownerTeacher           User                   @relation("ClassroomOwner", fields: [ownerTeacherId], references: [id])
  membershipAuditEntries MembershipAuditEntry[]
  tasks                  Task[]
  hintPolicy             ClassroomHintPolicy?
  studentHintPermissions StudentHintPermission[]
  hintInteractions       HintInteraction[]
}

model ClassMembership {
  id           String                 @id @default(cuid())
  classroomId  String
  userId       String
  role         MembershipRole
  joinedAt     DateTime               @default(now())
  active       Boolean                @default(true)
  classroom    Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEntries MembershipAuditEntry[]

  @@unique([classroomId, userId])
}

model MembershipAuditEntry {
  id             String                @id @default(cuid())
  classroomId    String
  membershipId   String
  studentId      String
  actorTeacherId String
  action         MembershipAuditAction
  reason         String?
  createdAt      DateTime              @default(now())
  actorTeacher   User                  @relation("MembershipAuditActor", fields: [actorTeacherId], references: [id])
  classroom      Classroom             @relation(fields: [classroomId], references: [id])
  membership     ClassMembership       @relation(fields: [membershipId], references: [id])
  student        User                  @relation("MembershipAuditStudent", fields: [studentId], references: [id])

  @@index([classroomId, createdAt])
  @@index([membershipId, createdAt])
}

model Task {
  id                 String              @id @default(cuid())
  classroomId        String
  authorTeacherId    String
  title              String
  instructions       String
  constraints        String?
  allowedLanguages   AllowedLanguage[]
  status             TaskStatus          @default(DRAFT)
  deadline           DateTime?
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  cppStarterCode     String?
  javaStarterCode    String?
  maximumMarks       Int                 @default(10)
  version            Int                 @default(1)
  codingSessions     CodingSession[]
  rubricCriteria     RubricCriterion[]
  submissionAttempts SubmissionAttempt[]
  authorTeacher      User                @relation("TaskAuthor", fields: [authorTeacherId], references: [id])
  classroom          Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  testCases          TestCase[]
  hintInteractions   HintInteraction[]
}

model RubricCriterion {
  id           String                           @id @default(cuid())
  taskId       String
  position     Int
  title        String
  maximumMarks Int
  createdAt    DateTime                         @default(now())
  updatedAt    DateTime                         @updatedAt
  task         Task                             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  reviewScores SubmissionReviewCriterionScore[]

  @@unique([taskId, position])
}

model TestCase {
  id             String   @id @default(cuid())
  taskId         String
  position       Int
  input          String
  expectedOutput String
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}

model CodingSession {
  id                 String              @id @default(cuid())
  taskId             String
  studentId          String
  attemptNumber      Int
  language           AllowedLanguage
  status             CodingSessionStatus @default(ACTIVE)
  startedAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  submittedAt        DateTime?
  draft              Draft?
  runs               RunAttempt[]
  events             CodeEvent[]
  student            User                @relation("StudentCodingSessions", fields: [studentId], references: [id])
  task               Task                @relation(fields: [taskId], references: [id])
  submission         SubmissionAttempt?
  hintInteractions   HintInteraction[]
  executionJobs      ExecutionJob[]

  @@unique([taskId, studentId, attemptNumber])
  @@index([taskId, studentId, status])
}

model Draft {
  id              String        @id @default(cuid())
  codingSessionId String        @unique
  sourceCode      String
  revision        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  codingSession   CodingSession @relation(fields: [codingSessionId], references: [id])
}

model RunAttempt {
  id                 String          @id @default(cuid())
  codingSessionId    String
  sequence           Int
  language           AllowedLanguage
  sourceCodeSnapshot String
  requestedAt        DateTime        @default(now())
  completedAt        DateTime?
  events             CodeEvent[]
  resultSnapshot     ResultSnapshot?
  executionJob       ExecutionJob?
  codingSession      CodingSession   @relation(fields: [codingSessionId], references: [id])

  @@unique([codingSessionId, sequence])
}

model ExecutionJob {
  id             String             @id @default(cuid())
  runAttemptId   String             @unique
  codingSessionId String
  studentId      String
  kind           ExecutionJobKind
  status         ExecutionJobStatus @default(QUEUED)
  idempotencyKey String?
  attemptCount   Int                @default(0)
  availableAt    DateTime           @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastError      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  runAttempt     RunAttempt         @relation(fields: [runAttemptId], references: [id], onDelete: Cascade)
  codingSession  CodingSession      @relation(fields: [codingSessionId], references: [id], onDelete: Cascade)
  student        User               @relation("StudentExecutionJobs", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, idempotencyKey])
  @@index([status, availableAt, createdAt])
  @@index([codingSessionId, status])
}

model ExecutionWorkerHeartbeat {
  id          String   @id @default(cuid())
  workerId    String   @unique
  concurrency Int
  startedAt   DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
}

model ResultSnapshot {
  id                 String             @id @default(cuid())
  runAttemptId       String             @unique
  state              RunResultState
  passedTests        Int
  totalTests         Int
  errorText          String?
  testResults        Json
  createdAt          DateTime           @default(now())
  visiblePassedTests Int?
  visibleTotalTests  Int?
  hiddenPassedTests  Int?
  hiddenTotalTests   Int?
  suggestedScore     Float?
  executionMode      ExecutionMode?
  runAttempt         RunAttempt         @relation(fields: [runAttemptId], references: [id])
  submission         SubmissionAttempt?
}

model SubmissionAttempt {
  id                    String                 @id @default(cuid())
  taskId                String
  studentId             String
  codingSessionId       String                 @unique
  resultSnapshotId      String                 @unique
  attemptNumber         Int
  idempotencyKey        String
  language              AllowedLanguage
  sourceCodeSnapshot    String
  submittedAt           DateTime               @default(now())
  practicalVersion      Int?
  timingStatus          SubmissionTimingStatus?
  events                CodeEvent[]
  codingSession         CodingSession          @relation(fields: [codingSessionId], references: [id])
  resultSnapshot        ResultSnapshot         @relation(fields: [resultSnapshotId], references: [id])
  student               User                   @relation("StudentSubmissions", fields: [studentId], references: [id])
  task                  Task                   @relation(fields: [taskId], references: [id])
  review                SubmissionReview?
  aiGenerationAuditLogs AiGenerationAuditLog[]

  @@unique([taskId, studentId, attemptNumber])
  @@unique([studentId, idempotencyKey])
  @@index([taskId, studentId, submittedAt])
}

model SubmissionReview {
  id                  String                           @id @default(cuid())
  submissionAttemptId String                           @unique
  reviewerTeacherId   String
  feedback            String
  marksAwarded        Int
  marksOutOf          Int                              @default(10)
  status              SubmissionReviewStatus           @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt
  criterionScores     SubmissionReviewCriterionScore[]
  reviewerTeacher     User                             @relation("TeacherSubmissionReviews", fields: [reviewerTeacherId], references: [id])
  revisions           SubmissionReviewRevision[]
  submissionAttempt   SubmissionAttempt                @relation(fields: [submissionAttemptId], references: [id])

  @@index([reviewerTeacherId, status])
}

model SubmissionReviewCriterionScore {
  id           String           @id @default(cuid())
  reviewId     String
  criterionId  String
  marksAwarded Int
  criterion    RubricCriterion  @relation(fields: [criterionId], references: [id], onDelete: Restrict)
  review       SubmissionReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, criterionId])
}

model SubmissionReviewRevision {
  id                String                 @id @default(cuid())
  reviewId          String
  reviewerTeacherId String
  version           Int
  feedback          String
  marksAwarded      Int
  marksOutOf        Int
  status            SubmissionReviewStatus
  publishedAt       DateTime?
  rubricScores      Json
  createdAt         DateTime               @default(now())
  review            SubmissionReview       @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  reviewerTeacher   User                   @relation("TeacherSubmissionReviewRevisions", fields: [reviewerTeacherId], references: [id], onDelete: Restrict)

  @@unique([reviewId, version])
  @@index([reviewId, createdAt])
}

model CodeEvent {
  id                  String             @id @default(cuid())
  codingSessionId     String
  sequence            Int
  type                CodeEventType
  runAttemptId        String?
  submissionAttemptId String?
  occurredAt          DateTime           @default(now())
  codingSession       CodingSession      @relation(fields: [codingSessionId], references: [id])
  runAttempt          RunAttempt?        @relation(fields: [runAttemptId], references: [id], onDelete: Restrict)
  submissionAttempt   SubmissionAttempt? @relation(fields: [submissionAttemptId], references: [id], onDelete: Restrict)

  @@unique([codingSessionId, sequence])
  @@index([codingSessionId, occurredAt])
}

enum PlatformRole {
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
  PENDING_TEACHER_APPROVAL
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipRole {
  TEACHER
  STUDENT
}

enum MembershipAuditAction {
  DEACTIVATED
  REACTIVATED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
}

enum AllowedLanguage {
  CPP
  JAVA
}

enum CodingSessionStatus {
  ACTIVE
  SUBMITTED
}

enum RunResultState {
  COMPLETED
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum ExecutionMode {
  SIMULATED
  JAVA_DOCKER_LOCAL
  CPP_DOCKER_LOCAL
  JAVA_DOCKER_REMOTE
  CPP_DOCKER_REMOTE
}

enum ExecutionJobKind {
  RUN
  SUBMIT
}

enum ExecutionJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum CodeEventType {
  SESSION_STARTED
  DRAFT_SAVED
  RUN_REQUESTED
  RUN_COMPLETED
  SUBMISSION_CREATED
}

enum SubmissionReviewStatus {
  DRAFT
  PUBLISHED
}

enum SubmissionTimingStatus {
  ON_TIME
  LATE
}

model ClassroomHintPolicy {
  id                 String    @id @default(cuid())
  classroomId        String    @unique
  enabledForAll      Boolean   @default(false)
  updatedByTeacherId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  classroom          Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  updatedByTeacher   User      @relation("TeacherHintPolicyUpdates", fields: [updatedByTeacherId], references: [id])
}

model StudentHintPermission {
  id                 String    @id @default(cuid())
  classroomId        String
  studentId          String
  enabled            Boolean
  grantedByTeacherId String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  classroom          Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student            User      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grantedByTeacher   User      @relation("TeacherHintPermissionsGranted", fields: [grantedByTeacherId], references: [id])

  @@unique([classroomId, studentId])
  @@index([classroomId, studentId])
}

model HintInteraction {
  id               String        @id @default(cuid())
  studentId        String
  classroomId      String
  taskId           String
  codingSessionId  String
  hintLevel        Int
  category         String
  hintText         String
  nextQuestion     String
  focusLines       Int[]
  inputContextHash String
  createdAt        DateTime      @default(now())
  codingSession    CodingSession @relation(fields: [codingSessionId], references: [id], onDelete: Cascade)
  student          User          @relation("StudentHintInteractions", fields: [studentId], references: [id], onDelete: Cascade)
  classroom        Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  task             Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([codingSessionId, hintLevel])
  @@index([taskId, studentId])
  @@index([classroomId, studentId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  actorUser   User     @relation("AdminAuditActor", fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
}

model AiGenerationAuditLog {
  id                  String             @id @default(cuid())
  teacherId           String
  submissionAttemptId String?
  kind                String
  modelUsed           String
  promptTokenEstimate Int
  cachedResult        Boolean            @default(false)
  durationMs          Int
  status              String
  sourceCodeHash      String
  createdAt           DateTime           @default(now())
  teacher             User               @relation("TeacherAiGenerations", fields: [teacherId], references: [id])
  submissionAttempt   SubmissionAttempt? @relation(fields: [submissionAttemptId], references: [id], onDelete: SetNull)

  @@index([teacherId, createdAt])
  @@index([sourceCodeHash])
  @@index([submissionAttemptId])
}
