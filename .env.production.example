# ==============================================================================
# TRACE / LABRIX — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env.production` on your deployment platform (Vercel, Railway, etc.)

# --- DATABASE (PostgreSQL with Connection Pooling) ---
# Neon, Supabase, or AWS RDS PostgreSQL connection string with PgBouncer
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/labrix?sslmode=require&pgbouncer=true"
# Direct database URL for Prisma migrations (non-pooled)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/labrix?sslmode=require"

# --- AUTHENTICATION & IDENTITY (Clerk) ---
# Switch to 'clerk' in production
LABRIX_IDENTITY_MODE="clerk"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_publishable_key"
CLERK_SECRET_KEY="sk_live_your_clerk_secret_key"
CLERK_WEBHOOK_SECRET="whsec_your_clerk_webhook_signing_secret"

# --- TEACHER ACCOUNT VERIFICATION (Resend) ---
LABRIX_APP_URL="https://trace.example.edu"
RESEND_API_KEY="re_your_resend_api_key"
TEACHER_APPROVAL_EMAIL="administrator@example.edu"
TEACHER_APPROVAL_FROM_EMAIL="TRACE <approvals@trace.example.edu>"
TEACHER_APPROVAL_SECRET="replace_with_at_least_32_random_characters"

# Public Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# --- AI EVIDENCE & VIVA ORAL DEFENSE (Groq / Gemini) ---
LABRIX_AI_REVIEW_PROVIDER="groq"
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_AI_REVIEW_MODEL="openai/gpt-oss-20b"
LABRIX_AI_REVIEW_TIMEOUT_MS="10000"

# Optional Gemini Fallback
GEMINI_API_KEY=""

# --- CODE EXECUTION RUNNERS (Docker / Sandbox) ---
# Production uses authenticated HTTPS runner services. Loopback local-docker
# workers are only for the explicitly supervised local professor demo.
LABRIX_EXECUTION_PROVIDER="remote-docker"
LABRIX_JAVA_RUNNER_URL="https://java-runner.example.edu/v1/execute/java"
LABRIX_CPP_RUNNER_URL="https://cpp-runner.example.edu/v1/execute/cpp"
LABRIX_RUNNER_BEARER_TOKEN="replace_with_at_least_32_random_characters"
LABRIX_ALLOW_LOCAL_RUNNERS_IN_PRODUCTION="false"

# --- SECURITY & RATE LIMITING ---
# Required shared rate limiting for multi-instance and serverless production.
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="replace_with_your_upstash_token"

# --- ENVIRONMENT FLAGS ---
NODE_ENV="production"
LABRIX_ALLOW_DEMO_IDENTITY_IN_PRODUCTION_BUILD="false"
