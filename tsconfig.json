{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/server/*": ["backend/server/*"],
      "@/data/*": ["backend/data/*"],
      "@/domain/*": ["backend/domain/*"],
      "@/lib/*": ["backend/lib/*"],
      "@/runner/*": ["backend/runner/*"],
      "@/prisma/*": ["backend/prisma/*"],
      "@/components/*": ["frontend/components/*"],
      "@/features/*": ["frontend/features/*"],
      "@/app/*": ["frontend/app/*"],
      "@/proxy": ["frontend/proxy"],
      "@/*": ["frontend/*", "backend/*"],
      "@frontend/*": ["frontend/*"],
      "@backend/*": ["backend/*"]
    }
  },
  "include": [
    "frontend/next-env.d.ts",
    "frontend/**/*.ts",
    "frontend/**/*.tsx",
    "backend/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
