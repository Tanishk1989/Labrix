DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
LABRIX_IDENTITY_MODE=clerk

# AI Gateway Policy Mode: EXPLICIT_TEACHER_OPT_IN (requires explicit teacher action)
AI_GATEWAY_POLICY_MODE=EXPLICIT_TEACHER_OPT_IN
GROQ_API_KEY=
GEMINI_API_KEY=

# Distributed rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Execution provider: local-docker for development, remote-docker for production
LABRIX_EXECUTION_PROVIDER=local-docker
LABRIX_EXECUTION_DISPATCH=inline
LABRIX_JAVA_RUNNER_URL=http://127.0.0.1:4010/v1/execute/java
LABRIX_CPP_RUNNER_URL=http://127.0.0.1:4020/v1/execute/cpp
LABRIX_RUNNER_BEARER_TOKEN=
LABRIX_ALLOW_LOCAL_RUNNERS_IN_PRODUCTION=false
RUNNER_MAX_CONCURRENCY=4
RUNNER_MAX_QUEUE_SIZE=64
RUNNER_QUEUE_TIMEOUT_MS=60000

# Durable worker settings used on the Google Cloud runner VM.
EXECUTION_WORKER_CONCURRENCY=8
EXECUTION_WORKER_POLL_MS=500
EXECUTION_JOB_LEASE_MS=120000
EXECUTION_JOB_MAX_ATTEMPTS=3

# Used only by the supervised local professor-demo launcher so `next start`
# can serve an optimized build with seeded demo actors. Never enable this in a
# deployed environment.
LABRIX_ALLOW_DEMO_IDENTITY_IN_PRODUCTION_BUILD=false

# Required only for database-mutating integration or Playwright verification.
# Use a disposable database/branch that is different from DATABASE_URL.
LABRIX_TEST_DATABASE_URL=
LABRIX_ALLOW_TEST_DATABASE_MUTATION=false

# Optional inputs for the controlled local identity-link command.
LABRIX_LINK_USER_ID=
LABRIX_LINK_CLERK_SUBJECT=
