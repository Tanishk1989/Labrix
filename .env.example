DATABASE_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
LABRIX_IDENTITY_MODE=demo

# Production requires LABRIX_IDENTITY_MODE=clerk, a production Clerk instance,
# DATABASE_URL, and both Clerk keys above. Never commit actual values.

# Execution remains mock by default. java-http and cpp-http are local-only
# Docker proofs. Production rejects them unless the explicit exception flag is
# exactly true; the exception does not make either runner production-ready.
LABRIX_EXECUTION_PROVIDER=mock
LABRIX_JAVA_RUNNER_URL=http://127.0.0.1:4010/v1/execute/java
LABRIX_CPP_RUNNER_URL=http://127.0.0.1:4020/v1/execute/cpp
LABRIX_ALLOW_LOCAL_RUNNERS_IN_PRODUCTION=false

# AI review briefs remain fake by default. Groq is an explicit prototype/demo
# provider only; configure all three Groq values before selecting it. Submitted
# source and minimized teacher-only evidence will leave Labrix when enabled.
LABRIX_AI_REVIEW_PROVIDER=fake
GROQ_API_KEY=
GROQ_AI_REVIEW_MODEL=
LABRIX_AI_REVIEW_TIMEOUT_MS=15000

# Required only for database-mutating integration or Playwright verification.
# Use a disposable database/branch that is different from DATABASE_URL.
LABRIX_TEST_DATABASE_URL=
LABRIX_ALLOW_TEST_DATABASE_MUTATION=false

# Optional inputs for the controlled local identity-link command.
LABRIX_LINK_USER_ID=
LABRIX_LINK_CLERK_SUBJECT=
LABRIX_ALLOW_IDENTITY_LINKING=false

# Enable only in the environment of one confirmed administrator command.
LABRIX_ALLOW_TEACHER_PROVISIONING=false
