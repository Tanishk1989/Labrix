generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  TEACHER
  STUDENT
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ClassroomStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipRole {
  TEACHER
  STUDENT
}

enum MembershipAuditAction {
  DEACTIVATED
  REACTIVATED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
}

enum AllowedLanguage {
  CPP
  JAVA
}

enum CodingSessionStatus {
  ACTIVE
  SUBMITTED
}

enum RunResultState {
  COMPLETED
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
  INTERNAL_ERROR
}

enum ExecutionMode {
  SIMULATED
  JAVA_DOCKER_LOCAL
  CPP_DOCKER_LOCAL
}

enum SubmissionTimingStatus {
  ON_TIME
  LATE
}

enum CodeEventType {
  SESSION_STARTED
  DRAFT_SAVED
  RUN_REQUESTED
  RUN_COMPLETED
  SUBMISSION_CREATED
}

enum SubmissionReviewStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                             String                 @id @default(cuid())
  name                           String
  email                          String                 @unique
  platformRole                   PlatformRole
  accountStatus                  AccountStatus          @default(ACTIVE)
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  externalIdentities             ExternalIdentity[]
  classroomsOwned                Classroom[]            @relation("ClassroomOwner")
  memberships                    ClassMembership[]
  tasksAuthored                  Task[]                 @relation("TaskAuthor")
  codingSessions                 CodingSession[]        @relation("StudentCodingSessions")
  submissionAttempts             SubmissionAttempt[]    @relation("StudentSubmissions")
  submissionReviews              SubmissionReview[]     @relation("TeacherSubmissionReviews")
  studentMembershipAuditEntries  MembershipAuditEntry[] @relation("MembershipAuditStudent")
  authoredMembershipAuditEntries MembershipAuditEntry[] @relation("MembershipAuditActor")
}

model ExternalIdentity {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model Classroom {
  id                     String                 @id @default(cuid())
  name                   String
  subject                String
  section                String
  ownerTeacherId         String
  joinCode               String                 @unique
  status                 ClassroomStatus        @default(ACTIVE)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  ownerTeacher           User                   @relation("ClassroomOwner", fields: [ownerTeacherId], references: [id])
  memberships            ClassMembership[]
  tasks                  Task[]
  membershipAuditEntries MembershipAuditEntry[]
}

model ClassMembership {
  id           String                 @id @default(cuid())
  classroomId  String
  userId       String
  role         MembershipRole
  joinedAt     DateTime               @default(now())
  active       Boolean                @default(true)
  classroom    Classroom              @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditEntries MembershipAuditEntry[]

  @@unique([classroomId, userId])
}

model MembershipAuditEntry {
  id             String                @id @default(cuid())
  classroomId    String
  membershipId   String
  studentId      String
  actorTeacherId String
  action         MembershipAuditAction
  reason         String?
  createdAt      DateTime              @default(now())
  classroom      Classroom             @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  membership     ClassMembership       @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  student        User                  @relation("MembershipAuditStudent", fields: [studentId], references: [id], onDelete: Restrict)
  actorTeacher   User                  @relation("MembershipAuditActor", fields: [actorTeacherId], references: [id], onDelete: Restrict)

  @@index([classroomId, createdAt])
  @@index([membershipId, createdAt])
}

model Task {
  id                 String              @id @default(cuid())
  version            Int                 @default(1)
  classroomId        String
  authorTeacherId    String
  title              String
  instructions       String
  constraints        String?
  allowedLanguages   AllowedLanguage[]
  cppStarterCode     String?
  javaStarterCode    String?
  status             TaskStatus          @default(DRAFT)
  deadline           DateTime?
  publishedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  classroom          Classroom           @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  authorTeacher      User                @relation("TaskAuthor", fields: [authorTeacherId], references: [id])
  testCases          TestCase[]
  codingSessions     CodingSession[]
  submissionAttempts SubmissionAttempt[]
}

model TestCase {
  id             String   @id @default(cuid())
  taskId         String
  position       Int
  input          String
  expectedOutput String
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  task           Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, position])
}

model CodingSession {
  id            String              @id @default(cuid())
  taskId        String
  studentId     String
  attemptNumber Int
  status        CodingSessionStatus @default(ACTIVE)
  language      AllowedLanguage     @default(CPP)
  startedAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  submittedAt   DateTime?
  task          Task                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  student       User                @relation("StudentCodingSessions", fields: [studentId], references: [id], onDelete: Restrict)
  draft         Draft?
  runs          RunAttempt[]
  submission    SubmissionAttempt?
  events        CodeEvent[]

  @@unique([taskId, studentId, attemptNumber])
  @@index([taskId, studentId, status])
}

model Draft {
  id              String        @id @default(cuid())
  codingSessionId String        @unique
  sourceCode      String
  revision        Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  codingSession   CodingSession @relation(fields: [codingSessionId], references: [id], onDelete: Cascade)
}

model RunAttempt {
  id                 String          @id @default(cuid())
  codingSessionId    String
  sequence           Int
  language           AllowedLanguage
  sourceCodeSnapshot String
  requestedAt        DateTime        @default(now())
  completedAt        DateTime?
  codingSession      CodingSession   @relation(fields: [codingSessionId], references: [id], onDelete: Restrict)
  resultSnapshot     ResultSnapshot?
  events             CodeEvent[]

  @@unique([codingSessionId, sequence])
}

model ResultSnapshot {
  id                 String             @id @default(cuid())
  runAttemptId       String             @unique
  state              RunResultState
  executionMode      ExecutionMode?
  passedTests        Int
  totalTests         Int
  visiblePassedTests Int?
  visibleTotalTests  Int?
  hiddenPassedTests  Int?
  hiddenTotalTests   Int?
  suggestedScore     Float?
  errorText          String?
  testResults        Json
  createdAt          DateTime           @default(now())
  runAttempt         RunAttempt         @relation(fields: [runAttemptId], references: [id], onDelete: Restrict)
  submission         SubmissionAttempt?
}

model SubmissionAttempt {
  id                 String                  @id @default(cuid())
  taskId             String
  studentId          String
  codingSessionId    String                  @unique
  resultSnapshotId   String                  @unique
  attemptNumber      Int
  idempotencyKey     String
  language           AllowedLanguage
  sourceCodeSnapshot String
  submittedAt        DateTime                @default(now())
  timingStatus       SubmissionTimingStatus?
  practicalVersion   Int?
  task               Task                    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  student            User                    @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  codingSession      CodingSession           @relation(fields: [codingSessionId], references: [id], onDelete: Restrict)
  resultSnapshot     ResultSnapshot          @relation(fields: [resultSnapshotId], references: [id], onDelete: Restrict)
  events             CodeEvent[]
  review             SubmissionReview?

  @@unique([taskId, studentId, attemptNumber])
  @@unique([studentId, idempotencyKey])
  @@index([taskId, studentId, submittedAt])
}

model SubmissionReview {
  id                  String                 @id @default(cuid())
  submissionAttemptId String                 @unique
  reviewerTeacherId   String
  feedback            String
  marksAwarded        Int
  marksOutOf          Int                    @default(10)
  status              SubmissionReviewStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  submissionAttempt   SubmissionAttempt      @relation(fields: [submissionAttemptId], references: [id], onDelete: Restrict)
  reviewerTeacher     User                   @relation("TeacherSubmissionReviews", fields: [reviewerTeacherId], references: [id], onDelete: Restrict)

  @@index([reviewerTeacherId, status])
}

model CodeEvent {
  id                  String             @id @default(cuid())
  codingSessionId     String
  sequence            Int
  type                CodeEventType
  runAttemptId        String?
  submissionAttemptId String?
  occurredAt          DateTime           @default(now())
  codingSession       CodingSession      @relation(fields: [codingSessionId], references: [id], onDelete: Restrict)
  runAttempt          RunAttempt?        @relation(fields: [runAttemptId], references: [id], onDelete: Restrict)
  submissionAttempt   SubmissionAttempt? @relation(fields: [submissionAttemptId], references: [id], onDelete: Restrict)

  @@unique([codingSessionId, sequence])
  @@index([codingSessionId, occurredAt])
}
